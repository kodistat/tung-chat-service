# Port the HTTP/WebSocket server listens on (App Platform sets this to 8080).
PORT=4000
# Comma-separated list of browser origins allowed to open /ws.
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4173
# Header carrying the real client IP behind a proxy. Set to do-connecting-ip on App Platform; leave empty locally.
TRUSTED_IP_HEADER=
LOG_LEVEL=info
